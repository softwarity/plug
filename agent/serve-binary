#!/bin/sh
# ForceCommand for the anonymous "get" user. It can only:
#   version                          print the agent version
#   install <os>-<arch> (uname)      emit a self-contained installer (binary embedded)
#   <os>-<arch> (uname)              stream that raw CLI binary on stdout
# Nothing else — no shell, ever.
cmd=$(printf '%s' "$SSH_ORIGINAL_COMMAND" | tr 'A-Z' 'a-z')
set -- $cmd
verb=$1
arg=$2

# binary_path <os-arch> -> /opt/plug/bin/plug-<os>-<arch>[.exe], normalizing arches.
binary_path() {
  o=${1%%-*}
  a=${1#*-}
  case "$a" in x86_64|amd64) a=amd64 ;; aarch64|arm64) a=arm64 ;; esac
  ext=""
  [ "$o" = windows ] && ext=".exe"
  printf '/opt/plug/bin/plug-%s-%s%s' "$o" "$a" "$ext"
}

if [ "$verb" = "version" ]; then
  exec cat /opt/plug/VERSION
fi

# install: the client passes its uname os-arch; we embed THAT binary in the
# installer, so the script needs neither the host nor a re-download. The cluster
# is set up on the CLI's first run (its wizard) — the agent can't know the
# address you reached it on (a Swarm routing mesh hides it).
if [ "$verb" = "install" ]; then
  f=$(binary_path "$arg")
  if [ -z "$arg" ] || [ ! -f "$f" ]; then
    echo "plug: unknown platform '$arg' — use: install \$(uname -s)-\$(uname -m)" >&2
    exit 1
  fi
  cat <<INSTALLER
#!/bin/sh
# plug installer (v$(cat /opt/plug/VERSION)) — https://softwarity.github.io/plug/
set -e
for d in "\$HOME/.local/bin" /usr/local/bin; do
  mkdir -p "\$d" 2>/dev/null && [ -w "\$d" ] && dest="\$d" && break
done
: "\${dest:?plug: no writable bin dir found (need ~/.local/bin or /usr/local/bin)}"
{ base64 -d 2>/dev/null || base64 -D; } > "\$dest/plug" <<'PLUG_B64'
$(base64 < "$f")
PLUG_B64
chmod +x "\$dest/plug"
echo "plug: installed to \$dest/plug"
case ":\$PATH:" in *":\$dest:"*) : ;; *) echo "plug: add \$dest to your PATH" ;; esac
echo "plug: run 'plug <your command>' — the first run asks for your cluster"
INSTALLER
  exit 0
fi

# raw binary (used by the launcher's version fetch and manual downloads)
f=$(binary_path "$verb")
if [ -n "$verb" ] && [ -f "$f" ]; then
  exec cat "$f"
fi

echo "plug $(cat /opt/plug/VERSION) — usage over ssh:" >&2
echo '  ssh -p <port> get@<host> install "$(uname -s)-$(uname -m)" | sh   # install (recommended)' >&2
echo '  ssh -p <port> get@<host> "$(uname -s)-$(uname -m)" > plug          # just the binary' >&2
echo '  ssh -p <port> get@<host> version' >&2
echo "  platforms: $(ls /opt/plug/bin | sed 's/^plug-//' | tr '\n' ' ')" >&2
exit 1
