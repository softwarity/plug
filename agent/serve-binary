#!/bin/sh
# ForceCommand for the anonymous "get" user. It can only:
#   version                    print the agent version
#   install [<profile>]        emit a self-contained installer (all binaries embedded;
#                              the script picks yours with uname), saving the cluster
#                              as that profile (default: named after the host)
#   install-windows, install.sh  the Windows installer script
#   wintun[-amd64|-arm64]      stream the WinTUN driver DLL
#   digest <os>-<arch>|wintun[-arch]  the sha256 and release signature of that file
#   <os>-<arch> (uname)        stream that raw CLI binary on stdout
# Nothing else: no shell, ever.
# set -f: SSH_ORIGINAL_COMMAND comes from the anonymous "get" account, so its
# content is attacker-controlled. The unquoted `set -- $cmd` below is there for
# the word splitting (verb + argument), but it also globs: a command of "*"
# would expand against the current directory, making the verb we run depend on
# whatever files happen to sit there. Keep the splitting, drop the globbing.
set -f

# install_vars prints the lines an installer starts with: what the command and
# whoever runs this agent decided for it. The profile to save is the name the
# command gave (`install <name>`), else the embedder's (PLUG_INSTALL_PROFILE: a
# gateway's application name), else none and the installer names it after the
# host. The key URL is where a hosted cluster has its developers register a
# key (PLUG_KEY_URL). Every value is checked here, because it is written into
# a script the developer runs: only the characters the rules allow reach it.
# $1 is the script's first line, printed once everything is checked: a refusal
# emits no script at all, so nothing runs on the other side of the pipe.
install_vars() {
  _iv_name=${2:-$(printf '%s' "${PLUG_INSTALL_PROFILE:-}" | tr 'A-Z' 'a-z')}
  # The rule plug applies to every profile name (cli/profiles_cmd.go).
  if [ -n "$_iv_name" ] && ! printf '%s\n' "$_iv_name" | grep -Eqx '[a-z0-9][a-z0-9._-]{0,62}'; then
    echo "plug: '$_iv_name' is not a profile name: a letter or digit, then letters, digits, dot, dash or underscore (63 max)" >&2
    exit 1
  fi
  _iv_url=${PLUG_KEY_URL:-}
  if [ -n "$_iv_url" ] && ! printf '%s\n' "$_iv_url" | grep -Eqx 'https?://[A-Za-z0-9._~:/?#@%=+&-]+'; then
    _iv_url=""
  fi
  _iv_hosted=""
  case "$(cat /opt/plug/VERSION 2>/dev/null)" in *-hosted) _iv_hosted=1 ;; esac
  printf "%s\n_name=%s\n_keyurl='%s'\n_hosted=%s\n" "$1" "$_iv_name" "$_iv_url" "$_iv_hosted"
}

cmd=$(printf '%s' "$SSH_ORIGINAL_COMMAND" | tr 'A-Z' 'a-z')
set -- $cmd
verb=$1

if [ "$verb" = "version" ]; then
  exec cat /opt/plug/VERSION
fi

# wintun.dll: the WinTUN driver DLL, baked into the image so the Windows installer
# fetches it from the agent (not wintun.net — no runtime external dependency, no
# intermittent fetch). Raw binary on stdout, like the CLI binaries below.
# `wintun` answers the AMD64 dll and always will. Windows arm64 asks for
# `wintun-arm64` instead, the same shape as `<os>-<arch>` for the binaries, and
# for the same reason: every Windows launcher already installed asks for `wintun`
# by that bare name, so making it architecture-dependent would hand an arm64
# driver to an amd64 machine on its next update and break a datapath that worked.
# A launcher too old to know the suffixed verb gets the usage text and says the
# download failed, which is the existing contract for an agent that cannot serve
# what was asked.
if [ "$verb" = "wintun" ] || [ "$verb" = "wintun-amd64" ] || [ "$verb" = "wintun-arm64" ]; then
  wf=/opt/plug/wintun.dll
  [ "$verb" = "wintun-arm64" ] && wf=/opt/plug/wintun-arm64.dll
  if [ -f "$wf" ]; then
    exec cat "$wf"
  fi
  echo "plug: $(basename "$wf") missing from this agent image" >&2
  exit 1
fi

# install-windows: stream the Git Bash installer. It downloads the exe and the
# dll over ssh (the `windows-<arch>` and `wintun[-arch]` verbs) rather than
# embedding them, and it picks the architecture from what WINDOWS reports rather
# than from uname, which lies under emulation. It is bash —
# not PowerShell — because Git Bash is the assumed Windows shell and a piped bash
# script's `exit` is reliable. Versioned at agent/install.sh, baked in at
# /opt/plug/install.sh. Invoke it with:
#   ssh get@<host> install-windows | bash -s -- <host> <port>
if [ "$verb" = "install-windows" ] || [ "$verb" = "install.sh" ]; then
  if [ -f /opt/plug/install.sh ]; then
    install_vars '#!/bin/bash' "${2:-}"
    exec cat /opt/plug/install.sh
  fi
  echo "plug: install.sh missing from this agent image" >&2
  exit 1
fi

# install: emit an installer with every unix binary embedded. The script runs
# uname CLIENT-side to pick the right one — so the command stays a bare
# `ssh get@host install | sh`, with no host and no arch to supply. (The agent
# genuinely can't know the address you reached it on — a routing mesh hides it —
# so the cluster is set on the CLI's first run.)
if [ "$verb" = "install" ]; then
  # The profile name: what the developer will type after -p, which the host
  # often says nothing about (localhost behind a port-forward, a gateway's app
  # name). See install_vars. Lower case, as the whole command is above.
  install_vars '#!/bin/sh' "${2:-}"
  cat <<'HEAD'
#!/bin/sh
set -e

# Pre-create a profile from *your* ssh command, named after the cluster host,
# or as the command said (`install <name>`, set above as _name).
# The agent can't know which address you reached it on (a routing mesh hides
# it), but your `ssh ... get@<host>` line does — and while this installer
# streams, that ssh is still alive in the process table (blocked sending the
# embedded binaries). So read host/port off it and save ~/.plug/<host>.conf,
# so the first `plug` run needs no wizard. Naming by host means installing from
# a second cluster (get@node1) adds a second profile rather than being ignored,
# so `plug -p node0` and `plug -p node1` can run side by side. Best-effort:
# silent if it can't tell (first run then falls back to the wizard); never
# clobbers an existing profile for that host.
_cmd=$(ps -A -o args= 2>/dev/null | grep 'get@' | grep -w install | grep -v grep | head -n1)
_host=$(printf '%s\n' "$_cmd" | sed -n 's/.*get@\([A-Za-z0-9._-]*\).*/\1/p')
_port=$(printf '%s\n' "$_cmd" | sed -n 's/.*-p[ =]*\([0-9][0-9]*\).*/\1/p')
_pname=${_name:-$_host}
if [ -n "$_host" ]; then
  _conf="$HOME/.plug/$_pname.conf"
  if [ -e "$_conf" ]; then
    _profile="'$_pname' (already configured)"
  else
    mkdir -p "$HOME/.plug"
    printf 'host = %s\nport = %s\n' "$_host" "${_port:-2222}" > "$_conf"
    _profile="'$_pname' -> $_host:${_port:-2222}"
  fi
fi

os=$(uname -s | tr 'A-Z' 'a-z')
arch=$(uname -m)
case "$arch" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; esac
for d in "$HOME/.local/bin" /usr/local/bin; do
  mkdir -p "$d" 2>/dev/null && [ -w "$d" ] && dest="$d" && break
done
: "${dest:?plug: no writable bin dir found (need ~/.local/bin or /usr/local/bin)}"
decode() { base64 -d 2>/dev/null || base64 -D; }
HEAD

  for f in /opt/plug/bin/plug-linux-amd64 /opt/plug/bin/plug-linux-arm64 \
           /opt/plug/bin/plug-darwin-amd64 /opt/plug/bin/plug-darwin-arm64; do
    [ -f "$f" ] || continue
    fn=$(basename "$f" | sed 's/^plug-//; s/-/_/')
    printf 'emit_%s() { decode <<'\''B64'\''\n' "$fn"
    base64 < "$f"
    printf 'B64\n}\n'
  done

  cat <<'TAIL'
# A previous install may have left plug as a setuid-root helper (macOS) or a
# root-owned cap binary (Linux): we own the DIRECTORY, so unlink it first (a `>`
# redirect can't overwrite a root file in place — "Permission denied" — and can't
# replace a running one either). rm on the dir entry always works; the new file
# is written fresh under our uid.
rm -f "$dest/plug" 2>/dev/null || true
case "$os-$arch" in
  linux-amd64)  emit_linux_amd64  > "$dest/plug" ;;
  linux-arm64)  emit_linux_arm64  > "$dest/plug" ;;
  darwin-amd64) emit_darwin_amd64 > "$dest/plug" ;;
  darwin-arm64) emit_darwin_arm64 > "$dest/plug" ;;
  *) echo "plug: unsupported platform $os-$arch (on Windows, use Git Bash: ssh get@<host> install-windows | bash -s -- <host> <port>)" >&2; exit 1 ;;
esac
chmod +x "$dest/plug"
echo "plug: installed to $dest/plug"
# Grant the privilege plug needs (TUN device + routes, per-launch mount ns, bind
# :53) ONCE, so day-to-day `plug <command>` runs with no sudo. sudo prompts on
# /dev/tty even through `| sh`. Linux = file capabilities; macOS has none, so it's
# a setuid-root helper that drops your command back to you (see privdrop_unix.go).
if [ "$os" = linux ]; then
  if command -v setcap >/dev/null 2>&1; then
    echo "plug: granting network capabilities (one sudo now → future runs need none)…"
    if sudo setcap cap_net_admin,cap_sys_admin,cap_net_bind_service+ep "$dest/plug"; then
      echo "plug: ready — 'plug <command>' runs without sudo"
    else
      echo "plug: setcap failed — meanwhile run 'sudo plug <command>', or fix with:" >&2
      echo "      sudo setcap cap_net_admin,cap_sys_admin,cap_net_bind_service+ep $dest/plug" >&2
    fi
  else
    echo "plug: 'setcap' missing (install libcap2-bin) — meanwhile run 'sudo plug <command>'" >&2
  fi
elif [ "$os" = darwin ]; then
  echo "plug: installing the privileged helper (one sudo now → future runs need none)…"
  # The core store, created root-owned while we already hold this one sudo.
  # macOS runs the cached core AS ROOT (the setuid helper drops privilege for
  # YOUR command, not for the core), so a store the user can write is a store
  # the user can hand root a different binary from. plug creates and cleans it
  # itself afterwards — nobody types sudo again, including to uninstall.
  sudo install -d -o root -g wheel -m 755 /var/db/plug /var/db/plug/versions 2>/dev/null \
    || echo "plug: could not create /var/db/plug — plug will say so on first run" >&2
  if sudo chown root:wheel "$dest/plug" && sudo chmod u+s "$dest/plug"; then
    echo "plug: ready — 'plug <command>' runs without sudo"
  else
    echo "plug: could not install the setuid helper — meanwhile run 'sudo plug <command>', or fix with:" >&2
    echo "      sudo chown root:wheel '$dest/plug' && sudo chmod u+s '$dest/plug'" >&2
  fi
fi
case ":$PATH:" in *":$dest:"*) : ;; *) echo "plug: add $dest to your PATH" ;; esac
if [ -n "$_profile" ]; then
  echo "plug: profile $_profile"
fi
# A hosted cluster lets in only the keys it knows: without this step, the
# first run is refused. Said with the profile it applies to, and where to
# register the key when the cluster said.
if [ -n "$_hosted" ]; then
  _kp=${_pname:-<profile>}
  echo "plug: this cluster lets in only the keys it knows. Give this machine its own, once:"
  echo "        plug keygen -p $_kp"
  echo "        plug pubkey -p $_kp"
  if [ -n "$_keyurl" ]; then
    echo "      and register the key it prints at $_keyurl"
  else
    echo "      and give the key it prints to whoever operates the cluster"
  fi
fi
if [ -n "$_profile" ]; then
  echo "plug: then run 'plug -p $_pname <your command>'  (the only profile? 'plug <your command>' is enough)"
else
  echo "plug: run 'plug <your command>'; the first run asks for your cluster"
fi
TAIL
  exit 0
fi

# digest <os>-<arch>: the SHA-256 of the binary this agent would serve, so the
# launcher can check the copy it CACHED is still the one it downloaded — the
# tamper it cannot otherwise see, since that cached file is executed with
# privilege on macOS and Linux.
#
# digest wintun / wintun-arm64: the same two lines for the driver DLL those
# verbs serve. It is loaded by the SYSTEM service on Windows, and until it was
# attested the launcher wrote it beside that service's binary on the strength
# of its size alone.
#
# key=value lines, deliberately: a signature (sig=, key=) can be added later
# without breaking a parser written today. A bare hash would have forced a new
# verb and a compatibility dance the first time we needed a second field.
if [ "$verb" = "digest" ]; then
  case "$2" in
    wintun|wintun-amd64) df=/opt/plug/wintun.dll ;;
    wintun-arm64)        df=/opt/plug/wintun-arm64.dll ;;
    *)
      do=${2%%-*}
      da=${2#*-}
      case "$da" in x86_64|amd64) da=amd64 ;; aarch64|arm64) da=arm64 ;; esac
      dext=""
      [ "$do" = windows ] && dext=".exe"
      df="/opt/plug/bin/plug-$do-$da$dext"
      ;;
  esac
  if [ ! -f "$df" ]; then
    echo "plug: no binary for $2 on this agent" >&2
    exit 1
  fi
  # sha256sum (coreutils) on Alpine; keep the busybox/openssl fallbacks so the
  # verb never silently reports nothing.
  if command -v sha256sum >/dev/null 2>&1; then
    echo "sha256=$(sha256sum "$df" | cut -d' ' -f1)"
  elif command -v openssl >/dev/null 2>&1; then
    echo "sha256=$(openssl dgst -sha256 "$df" | awk '{print $NF}')"
  else
    echo "plug: no sha256 tool in this agent image" >&2
    exit 1
  fi
  # The release signature over that file, written beside it at image build time
  # by cli/cmd/plug-sign (the DLLs included). This is what lets the launcher
  # refuse to execute, with root privilege, bytes that did not come from the
  # plug release workflow: the digest above is announced by this agent, and an
  # agent is whoever the caller pointed plug at. Absent on an image built
  # without the release key, which the launcher refuses to install from.
  if [ -f "$df.sig" ]; then
    echo "sig=$(cat "$df.sig")"
  fi
  exit 0
fi

# raw binary (used by the launcher's version fetch and manual downloads)
o=${verb%%-*}
a=${verb#*-}
case "$a" in x86_64|amd64) a=amd64 ;; aarch64|arm64) a=arm64 ;; esac
ext=""
[ "$o" = windows ] && ext=".exe"
f="/opt/plug/bin/plug-$o-$a$ext"
if [ -n "$verb" ] && [ -f "$f" ]; then
  exec cat "$f"
fi

echo "plug $(cat /opt/plug/VERSION) — usage over ssh:" >&2
echo '  # host key regenerated each start (not a secret) — skip the check:' >&2
echo '  ssh -p <port> -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null get@<host> install | sh   # install (linux/macOS, recommended)' >&2
echo '  ssh -n -p <port> -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null get@<host> install-windows | bash -s -- <host> <port>   # install (Windows, Git Bash)' >&2
exit 1
